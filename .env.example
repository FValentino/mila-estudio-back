PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
DB_HOST=localhost
DB_PORT=5432
DB_USER=replace_with_db_user
DB_PASSWORD=replace_with_db_password
DB_NAME=mila_estudio
# Optional. When set, DATABASE_URL takes precedence over DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=postgresql://replace_with_db_user:replace_with_db_password@localhost:5432/mila_estudio
# IANA timezone used for appointment-day filters. Defaults to America/Argentina/Buenos_Aires.
TIMEZONE=America/Argentina/Buenos_Aires
# Optional. Used only by `pnpm seed:admin` to create or update the admin user.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_admin_password
